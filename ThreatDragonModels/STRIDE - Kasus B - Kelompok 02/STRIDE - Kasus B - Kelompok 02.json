              "type": "tm.Store",
              "name": "Object Storage",
              "description": "Penyimpanan khusus isi file dokumen biner yang terpisah dari metadata.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "isALog": false,
              "storesCredentials": false,
              "isEncrypted": false,
              "isSigned": false,
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "caa972dc-2d03-46a8-a3ce-190fd57e2595",
                  "title": "Akses Langsung ke Isi File pada Object Storage Tanpa Validasi Backend",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Jika pihak tidak berwenang dapat mengakses endpoint Object Storage secara langsung tanpa melewati Backend Dokumen, maka bisa terjadi kebocoran isi dokumen meskipun tautan sudah kedaluwarsa melewati 24 jam atau telah dicabut oleh pemilik. Asumsi: bucket penyimpanan belum diblokir dari akses publik atau URL objek dapat ditebak. Skor Risiko: Kemungkinan (2) x Dampak (3) = 6 (Tinggi).",
                  "mitigation": "Blokir seluruh akses publik pada bucket Object Storage, batasi izin baca/tulis hanya untuk service account Backend Dokumen, dan layani unduhan melalui streaming backend atau short-lived pre-signed URL (berlaku hitungan menit) setelah validasi tautan berhasil.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": "6"
                }
              ]
            }
