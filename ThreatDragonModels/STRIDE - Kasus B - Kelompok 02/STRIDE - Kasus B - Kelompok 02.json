                {
                  "id": "71f03536-ae4e-4641-8137-09d268f1077b",
                  "title": "Pengunggahan File Berbahaya melalui Manipulasi Tipe File",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Jika pemilik dokumen atau akun yang dibajak dapat memanipulasi ekstensi maupun header Content-Type saat mengunggah file ke Backend Dokumen, maka bisa terjadi penyimpanan file berbahaya (malware) di Object Storage yang dapat menginfeksi perangkat penerima saat diunduh. Asumsi: backend hanya memercayai nama file dan tipe MIME dari browser tanpa memeriksa isi biner atau memindai malware. Skor Risiko: Kemungkinan (2) x Dampak (3) = 6 (Tinggi).",
                  "mitigation": "Validasi format file menggunakan magic bytes (bukan sekadar ekstensi), terapkan whitelist tipe file yang diizinkan, pindai file dengan antivirus sebelum disimpan ke Object Storage, dan paksa header Content-Disposition: attachment saat pengunduhan.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": "6"
                }
