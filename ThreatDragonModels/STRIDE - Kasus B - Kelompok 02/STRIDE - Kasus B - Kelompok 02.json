            "zIndex": 1,
            "data": {
              "type": "tm.Actor",
              "name": "Penerima Eksternal (Browser - Tanpa Login)",
              "description": "Pihak eksternal yang membuka tautan berbagi melalui browser tanpa login untuk mengunduh file.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "providesAuthentication": false,
              "threats": [
                {
                  "id": "8dd7fe81-0793-45fe-8118-d58411b813b8",
                  "title": "Penyalahgunaan Tautan Berbagi oleh Pihak Tidak Berwenang",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "Jika pihak tidak berwenang dapat menebak pola URL atau memperoleh tautan berbagi yang bocor/diteruskan lalu mengakses Backend Dokumen sebagai penerima, maka bisa terjadi pengunduhan dokumen rahasia oleh pihak selain penerima sah. Asumsi: penerima tidak wajib login sehingga kepemilikan URL menjadi satu-satunya bukti akses. Skor Risiko: Kemungkinan (3) x Dampak (3) = 9 (Tinggi).",
                  "mitigation": "Gunakan token acak kriptografis minimal 128-bit (CSPRNG/UUIDv4) untuk setiap tautan berbagi, serta sediakan opsi proteksi passphrase/PIN atau batas jumlah unduhan (download limit) untuk dokumen sensitif.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": "9"
                }
              ]
            }
          },
          {
