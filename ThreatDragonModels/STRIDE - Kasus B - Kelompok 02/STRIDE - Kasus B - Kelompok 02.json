            "zIndex": 2,
            "data": {
              "type": "tm.Process",
              "name": "Backend Dokumen",
              "description": "Komponen pengambil keputusan yang memproses unggah file, manajemen tautan 24 jam, validasi unduhan tanpa login, dan pencatatan log audit.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "privilegeLevel": "Internal Service",
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "bc9841cf-0ab8-4e0a-be20-8fc8afbea2a1",
                  "title": "Pembanjiran Permintaan Unduh Publik dan Unggah File Besar",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "Jika pihak tidak berwenang mengirimkan ribuan permintaan unduh otomatis ke endpoint tautan tanpa login atau mengunggah file berukuran sangat besar berulang kali ke Backend Dokumen, maka bisa terjadi kelelahan bandwidth, memori, dan kapasitas penyimpanan sehingga layanan tidak dapat diakses. Asumsi: endpoint publik belum memiliki rate limiting dan belum ada batasan ukuran file per unggahan. Skor Risiko: Kemungkinan (3) x Dampak (2) = 6 (Tinggi).",
                  "mitigation": "Terapkan rate limiting berbasis IP pada endpoint tautan publik, batasi ukuran maksimal file per unggahan beserta kuota penyimpanan per pengguna, dan gunakan mekanisme streaming agar transfer file tidak memenuhi RAM backend.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": "6"
                },
                {
                  "id": "1af1acea-ea08-4985-9b27-cf6f57923851",
                  "title": "Akses Isi File oleh Admin atau Pencabutan Tautan Pengguna Lain (IDOR)",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "Jika Admin Organisasi dapat memanggil endpoint pengunduhan pada Backend Dokumen untuk mengambil isi file, atau pengguna lain memanipulasi ID tautan untuk mencabut tautan milik pemilik lain, maka bisa terjadi pelanggaran prinsip least privilege dan pengambilalihan kendali akses dokumen secara tidak sah. Asumsi: otorisasi hanya memeriksa status login tanpa memverifikasi peran khusus Admin dan kepemilikan objek. Skor Risiko: Kemungkinan (2) x Dampak (3) = 6 (Tinggi).",
                  "mitigation": "Terapkan Role-Based Access Control (RBAC) ketat yang menolak peran Admin pada endpoint pengunduhan isi file, serta lakukan validasi kepemilikan objek (owner_id == current_user_id) pada setiap permintaan lihat daftar maupun pencabutan tautan.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": "6"
                }
              ]
            }
          },
