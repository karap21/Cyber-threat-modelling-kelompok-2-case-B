            "data": {
              "type": "tm.Store",
              "name": "Database Metadata",
              "description": "Menyimpan metadata dokumen (pemilik, nama file, tipe file, waktu unggah), detail tautan 24 jam, status pencabutan, dan log audit.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "isALog": true,
              "storesCredentials": false,
              "isEncrypted": false,
              "isSigned": false,
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "1d2389fe-be74-43ea-bccc-ce8bf4ef0c76",
                  "title": "Penyangkalan Aktivitas Unduhan karena Log Audit Tidak Memadai",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "Jika penerima eksternal mengunduh file atau pemilik mencabut tautan sementara pencatatan pada Database Metadata tidak menyimpan jejak kontekstual yang lengkap dan utuh, maka bisa terjadi penyangkalan aktivitas saat audit atau investigasi kebocoran dokumen. Asumsi: penerima tidak memiliki identitas akun dan log audit disimpan di tabel operasional biasa yang masih dapat diubah atau dihapus. Skor Risiko: Kemungkinan (2) x Dampak (2) = 4 (Sedang).",
                  "mitigation": "Wajibkan pencatatan timestamp UTC, ID tautan, ID file, alamat IP, User-Agent, dan status respons pada setiap aksi; atur tabel atau penyimpanan log audit bersifat append-only (hanya tambah, tidak dapat diubah atau dihapus).",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": "4"
                }
              ]
            }
          },
